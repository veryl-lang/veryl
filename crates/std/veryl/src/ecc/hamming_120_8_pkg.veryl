#[fmt(skip)]
pub package hamming_120_8_pkg {
    // data width = 120 check width = 8
    // row[7]: 111111101011011101011011010101110101011101011010110101101101101010010100100101010010010100010101001001001001010010100100 | 10000000
    // row[6]: 111111011101101010110110101101101011101010110110110110101101011001010011001001001001001010100010100100101010010010010100 | 01000000
    // row[5]: 111110110110110111001110101110011101011011010101101101011011011000101010010010100101010001010100100101000101001010010010 | 00100000
    // row[4]: 111101111011010101110101110011101010110110101101101101101011010110100100100100101000101010001010010010011001001001010010 | 00010000
    // row[3]: 111011111101011010101011011011010111010110110110011011011010110101010001010100010010100101010010010100100100100101001010 | 00001000
    // row[2]: 110111111010101110011011101100111010101101101011101011010110110110001010001001010100011000101001001010100100101001001001 | 00000100
    // row[1]: 101111110110101011110100110111010101110101101101010110110110101100100101001010001101000101000101010010010010010100101001 | 00000010
    // row[0]: 011111110101110101101101011010101110101011011011011010110101101101001000110010100010100010101000101001010010100100100101 | 00000001

    const DATA_WIDTH : u32 = 120;
    const CHECK_WIDTH: u32 = 8;
    const CODE_WIDTH : u32 = DATA_WIDTH + CHECK_WIDTH;

    // Coefficient matrix for check-bit generation.
    const ENCODE_MATRIX_ROW_0: bit<DATA_WIDTH> = 120'h7f5d6d6aeadb6b5b48ca28a8a52925; // check[0] (63 ones)
    const ENCODE_MATRIX_ROW_1: bit<DATA_WIDTH> = 120'hbf6af4dd5d6d5b6b2528d145492529; // check[1] (63 ones)
    const ENCODE_MATRIX_ROW_2: bit<DATA_WIDTH> = 120'hdfab9bb3ab6bad6d8a2546292a4a49; // check[2] (63 ones)
    const ENCODE_MATRIX_ROW_3: bit<DATA_WIDTH> = 120'hefd6ab6d75b66dad5151295252494a; // check[3] (63 ones)
    const ENCODE_MATRIX_ROW_4: bit<DATA_WIDTH> = 120'hf7b575ceadadb6b5a4928a8a499252; // check[4] (63 ones)
    const ENCODE_MATRIX_ROW_5: bit<DATA_WIDTH> = 120'hfb6dceb9d6d5b5b62a4a5454945292; // check[5] (63 ones)
    const ENCODE_MATRIX_ROW_6: bit<DATA_WIDTH> = 120'hfddab6b6bab6dad6532492a292a494; // check[6] (63 ones)
    const ENCODE_MATRIX_ROW_7: bit<DATA_WIDTH> = 120'hfeb75b57575ad6da949525152494a4; // check[7] (63 ones)

    // Syndrome produced by a single-bit error at each code bit.
    const ERROR_SYNDROME: bit<CHECK_WIDTH> [CODE_WIDTH] = '{
        8'h01, // check[0]
        8'h02, // check[1]
        8'h04, // check[2]
        8'h08, // check[3]
        8'h10, // check[4]
        8'h20, // check[5]
        8'h40, // check[6]
        8'h80, // check[7]
        8'h07, // data[0]
        8'h38, // data[1]
        8'hc1, // data[2]
        8'h0e, // data[3]
        8'h70, // data[4]
        8'h83, // data[5]
        8'h1c, // data[6]
        8'he0, // data[7]
        8'h0b, // data[8]
        8'h34, // data[9]
        8'hc2, // data[10]
        8'h0d, // data[11]
        8'hb0, // data[12]
        8'h43, // data[13]
        8'h2c, // data[14]
        8'hd0, // data[15]
        8'h13, // data[16]
        8'h4c, // data[17]
        8'ha1, // data[18]
        8'h16, // data[19]
        8'h68, // data[20]
        8'h85, // data[21]
        8'h1a, // data[22]
        8'h61, // data[23]
        8'h86, // data[24]
        8'h58, // data[25]
        8'ha2, // data[26]
        8'h15, // data[27]
        8'ha8, // data[28]
        8'h45, // data[29]
        8'h2a, // data[30]
        8'h51, // data[31]
        8'h8a, // data[32]
        8'h54, // data[33]
        8'ha4, // data[34]
        8'h19, // data[35]
        8'h62, // data[36]
        8'h89, // data[37]
        8'h26, // data[38]
        8'h52, // data[39]
        8'h8c, // data[40]
        8'h31, // data[41]
        8'hc4, // data[42]
        8'h23, // data[43]
        8'h98, // data[44]
        8'h46, // data[45]
        8'h29, // data[46]
        8'h91, // data[47]
        8'h4a, // data[48]
        8'h64, // data[49]
        8'h92, // data[50]
        8'h25, // data[51]
        8'hc8, // data[52]
        8'h32, // data[53]
        8'h49, // data[54]
        8'h94, // data[55]
        8'h1f, // data[56]
        8'he3, // data[57]
        8'h7c, // data[58]
        8'h8f, // data[59]
        8'hf1, // data[60]
        8'h3e, // data[61]
        8'hc7, // data[62]
        8'hf8, // data[63]
        8'h2f, // data[64]
        8'hd3, // data[65]
        8'hbc, // data[66]
        8'h4f, // data[67]
        8'hf2, // data[68]
        8'h3d, // data[69]
        8'hcb, // data[70]
        8'hf4, // data[71]
        8'h37, // data[72]
        8'hcd, // data[73]
        8'h7a, // data[74]
        8'h97, // data[75]
        8'he9, // data[76]
        8'h5e, // data[77]
        8'ha7, // data[78]
        8'h79, // data[79]
        8'h9e, // data[80]
        8'he5, // data[81]
        8'hba, // data[82]
        8'h57, // data[83]
        8'hea, // data[84]
        8'h5d, // data[85]
        8'hab, // data[86]
        8'h75, // data[87]
        8'hae, // data[88]
        8'hd5, // data[89]
        8'hda, // data[90]
        8'h3b, // data[91]
        8'he6, // data[92]
        8'h6d, // data[93]
        8'h9b, // data[94]
        8'h76, // data[95]
        8'h9d, // data[96]
        8'hec, // data[97]
        8'h73, // data[98]
        8'had, // data[99]
        8'hd6, // data[100]
        8'h5b, // data[101]
        8'hb3, // data[102]
        8'h6e, // data[103]
        8'hb5, // data[104]
        8'hce, // data[105]
        8'hb9, // data[106]
        8'h67, // data[107]
        8'hd9, // data[108]
        8'hb6, // data[109]
        8'h6b, // data[110]
        8'hdc, // data[111]
        8'h7f, // data[112]
        8'hbf, // data[113]
        8'hdf, // data[114]
        8'hef, // data[115]
        8'hf7, // data[116]
        8'hfb, // data[117]
        8'hfd, // data[118]
        8'hfe, // data[119]
    };

    struct decode_result {
        error_pos: logic<CODE_WIDTH>, // error position (one-hot, [CHECK_WIDTH-1:0]=check, upper=data)
        corrected: logic            , // a single-bit error was located and corrected
        detected : logic            , // an uncorrectable error was detected
    }

    /// Compute the check bits (AND with the coefficient matrix, then XOR reduction).
    function encode (
        data: input logic<DATA_WIDTH>,
    ) -> logic<CHECK_WIDTH> {
        var check: logic<CHECK_WIDTH>;
        check[0] = ^(ENCODE_MATRIX_ROW_0 & data);
        check[1] = ^(ENCODE_MATRIX_ROW_1 & data);
        check[2] = ^(ENCODE_MATRIX_ROW_2 & data);
        check[3] = ^(ENCODE_MATRIX_ROW_3 & data);
        check[4] = ^(ENCODE_MATRIX_ROW_4 & data);
        check[5] = ^(ENCODE_MATRIX_ROW_5 & data);
        check[6] = ^(ENCODE_MATRIX_ROW_6 & data);
        check[7] = ^(ENCODE_MATRIX_ROW_7 & data);
        return check;
    }

    /// Compute the syndrome (received check bits ^ recomputed check bits).
    function calc_syndrome (
        code: input logic<CODE_WIDTH>
    ) -> logic<CHECK_WIDTH> {
        var data : logic<DATA_WIDTH> ;
        var check: logic<CHECK_WIDTH>;
        data  = code[CODE_WIDTH-1-:DATA_WIDTH];
        check = code[0+:CHECK_WIDTH];
        return encode(data) ^ check;
    }

    /// Determine the error position and flags (corrected/detected) from the syndrome.
    /// A data-bit correction is honored only while its index is below the active width.
    function decode (
        syndrome: input logic<CHECK_WIDTH>,
        width   : input u32               ,
    ) -> decode_result {
        var result: decode_result;

        // Each bit compares the syndrome with its own H column, so the comparisons are
        // independent of each other. A non-zero syndrome that matches no column (including
        // a data bit beyond the active width) leaves error_pos zero and is reported as detected.
        for i in 0..CODE_WIDTH {
            result.error_pos[i] = syndrome == ERROR_SYNDROME[i] && i <: CHECK_WIDTH + width;
        }

        result.corrected = result.error_pos != '0;
        result.detected  = syndrome != '0 && !result.corrected;
        return result;
    }
}
