#[test(test_lzc_4)]
module test_lzc_4 {
    const RESULT_WIDTH: p32 = lzc_pkg::result_width(4);

    var bits  : logic<4>           ;
    var result: logic<RESULT_WIDTH>;

    initial {
        bits   = '0;
        result = lzc::<4>(bits, true);
        $assert(result[msb]);

        for i in 0..4 {
            var exp: logic<2>;

            bits    = '0;
            bits[i] = '1;
            result  = lzc::<4>(bits, true);

            exp = 3 - i;
            $assert(!result[msb]);
            $assert(result[msb - 1:0] == exp);
        }

        $finish();
    }
}

