#[test(test_lzc_128)]
module test_lzc_128 {
    const RESULT_WIDTH: p32 = lzc_pkg::result_width(128);

    var bits  : logic<128>         ;
    var result: logic<RESULT_WIDTH>;

    initial {
        bits   = '0;
        result = lzc::<128>(bits, true);
        $assert(result[msb]);

        for i in 0..128 {
            var exp: logic<7>;

            bits    = '0;
            bits[i] = '1;
            result  = lzc::<128>(bits, true);

            exp = 127 - i;
            $assert(!result[msb]);
            $assert(result[msb - 1:0] == exp);
        }

        $finish();
    }
}
