/// Round robin arbiter
///
/// Grants one of the requests in round robin order.
/// The round robin state holds the index of the last granted request and
/// the request with the next index has the highest priority.
///
/// * `PRIORITY_ENABLE`: Requests are classified by their priority and the request with the highest priority is granted.
///                      The round robin state is kept for each priority class.
/// * `WEIGHT_ENABLE`  : Each request can be granted `weight` times in a round.
pub module round_robin_arbiter #(
    param REQUESTS       : u32                                     = 4                                            ,
    param ONEHOT_GRANT   : bbool                                   = true                                         ,
    param GRANT_WIDTH    : u32                                     = calc_grant_width(REQUESTS, ONEHOT_GRANT)     ,
    param PRIORITY_ENABLE: bbool                                   = false                                        ,
    param PRIORITY_WIDTH : u32                                     = 1                                            ,
    param FIXED_PRIORITY : bbool                                   = false                                        ,
    param PRIORITY       : bit          <REQUESTS, PRIORITY_WIDTH> = '0                                           ,
    param WEIGHT_ENABLE  : bbool                                   = false                                        ,
    param WEIGHT_WIDTH   : u32                                     = 1                                            ,
    param INITIAL_WEIGHT : bit          <REQUESTS, WEIGHT_WIDTH>   = '1                                           ,
    param SELECTOR_KIND  : selector_kind                           = selector_kind::LZC                           ,
    const STATE_WIDTH    : u32                                     = clog2_clipped(REQUESTS, 1)                   ,
    const N_SLOTS        : u32                                     = calc_n_slots(PRIORITY_ENABLE, PRIORITY_WIDTH),
) (
    i_clk          : input  clock                                  , /// Clock
    i_rst          : input  reset                                  , /// Reset
    i_init         : input  logic                           = false, /// Initialize the round robin state and weights
    i_priority     : input  logic<REQUESTS, PRIORITY_WIDTH> = '0   , /// Priority of each request (used when `PRIORITY_ENABLE` and `!FIXED_PRIORITY`)
    i_weight_valid : input  logic                           = false, /// Use `i_weight` as the weights for the next round
    i_weight       : input  logic<REQUESTS, WEIGHT_WIDTH>   = '0   , /// Weight of each request
    i_request      : input  logic<REQUESTS>                        , /// Requests
    o_grant        : output logic<GRANT_WIDTH>                     , /// Grant (onehot or binary index)
    i_update_state : input  logic                           = true , /// Update the round robin state by the current grant
    o_current_state: output logic<N_SLOTS, STATE_WIDTH>     = _    , /// Current round robin state
) {
    import arbiter_pkg::*;
    import utils::clog2_clipped;

    const COMPARE_WIDTH: u32 = 2 + (if WEIGHT_ENABLE ? 1 : 0) + (if PRIORITY_ENABLE ? PRIORITY_WIDTH : 0);
    const WEIGHT_LSB   : u32 = 1;
    const PRIORITY_LSB : u32 = WEIGHT_LSB + (if WEIGHT_ENABLE ? 1 : 0);
    const REQUEST_LSB  : u32 = PRIORITY_LSB + (if PRIORITY_ENABLE ? PRIORITY_WIDTH : 0);

    var current_state : logic<N_SLOTS, STATE_WIDTH>  ;
    var weight        : logic<REQUESTS, WEIGHT_WIDTH>;
    var grant_location: logic<REQUESTS>              ;
    var grant_index   : logic<STATE_WIDTH>           ;
    var grant_priority: logic<PRIORITY_WIDTH>        ;

    //--------------------------------------------------------------
    //  Arbiter
    //--------------------------------------------------------------
    always_comb {
        if ONEHOT_GRANT {
            o_grant = grant_location as GRANT_WIDTH;
        } else {
            o_grant = grant_index as GRANT_WIDTH;
        }
        o_current_state = current_state;
    }

    if PRIORITY_ENABLE || WEIGHT_ENABLE || SELECTOR_KIND == selector_kind::FIND_MAX
        || (SELECTOR_KIND == selector_kind::LZC && REQUESTS >: 64) :g_arbiter {
        var compare_value: logic<REQUESTS, COMPARE_WIDTH>;
        var location     : logic<REQUESTS>               ;
        var max_value    : logic<COMPARE_WIDTH>          ;

        always_comb {
            for i in 0..REQUESTS {
                var priority_value: logic<PRIORITY_WIDTH>;

                if !PRIORITY_ENABLE {
                    priority_value = 0 as PRIORITY_WIDTH;
                } else if FIXED_PRIORITY {
                    priority_value = PRIORITY[i];
                } else {
                    priority_value = i_priority[i];
                }

                compare_value[i]              = '0;
                compare_value[i][0]           = (i as STATE_WIDTH) >: current_state[priority_value];
                compare_value[i][REQUEST_LSB] = i_request[i];
                if WEIGHT_ENABLE {
                    compare_value[i][WEIGHT_LSB] = weight[i] >= (1 as WEIGHT_WIDTH);
                }
                if PRIORITY_ENABLE {
                    compare_value[i][PRIORITY_LSB+:PRIORITY_WIDTH] = priority_value;
                }
            }

            // The comparator tree selects an entry even if there is no request
            arbiter_find_max::<REQUESTS, COMPARE_WIDTH>(compare_value, location, grant_index, max_value);

            grant_location = location & i_request;
            if PRIORITY_ENABLE {
                grant_priority = max_value[PRIORITY_LSB+:PRIORITY_WIDTH];
            } else {
                grant_priority = '0;
            }
        }
    } else if SELECTOR_KIND == selector_kind::LOWEST_BIT {
        const HIGHER_MASK: bit<REQUESTS, REQUESTS>        = init_higher_mask();
        const INDEX_MASK : bit<STATE_WIDTH, 2 * REQUESTS> = init_index_mask();

        var select: logic<2 * REQUESTS>;
        var lowest: logic<2 * REQUESTS>;

        // The lower half holds the requests above the current state and the upper half holds all requests.
        // The lowest set bit of the select signal is the grant, and no bit is set without any request.
        always_comb {
            select = {i_request, i_request & HIGHER_MASK[current_state[0]]};
            lowest = select & (~select + (1 as (2 * REQUESTS)));

            for i in 0..STATE_WIDTH {
                grant_index[i] = (lowest & INDEX_MASK[i]) != '0;
            }
            grant_location = lowest[0 step REQUESTS] | lowest[1 step REQUESTS];
            grant_priority = '0;
        }
    } else {
        const COUNT_WIDTH: u32                     = lzc_common_pkg::result_width(REQUESTS);
        const HIGHER_MASK: bit<REQUESTS, REQUESTS> = init_higher_mask();

        var select   : logic<2, REQUESTS>   ;
        var lzc_count: logic<2, COUNT_WIDTH>;

        always_comb {
            select = {i_request, i_request & HIGHER_MASK[current_state[0]]};

            lzc_count[0] = lzc::<REQUESTS>(select[0], false);
            lzc_count[1] = lzc::<REQUESTS>(select[1], false);

            if !lzc_count[0][msb] {
                grant_index = lzc_count[0] as STATE_WIDTH;
            } else if !lzc_count[1][msb] {
                grant_index = lzc_count[1] as STATE_WIDTH;
            } else {
                grant_index = '0;
            }

            if !lzc_count[1][msb] {
                grant_location = (1 as REQUESTS) << grant_index;
            } else {
                grant_location = '0;
            }
            grant_priority = '0;
        }
    }

    function init_higher_mask () -> bit<REQUESTS, REQUESTS> {
        var mask: bit<REQUESTS, REQUESTS>;

        for i in 0..REQUESTS {
            for j in 0..REQUESTS {
                mask[i][j] = j >: i;
            }
        }

        return mask;
    }

    function init_index_mask () -> bit<STATE_WIDTH, 2 * REQUESTS> {
        var mask: bit<STATE_WIDTH, 2 * REQUESTS>;

        for i in 0..STATE_WIDTH {
            for j in 0..REQUESTS {
                mask[i][0 * REQUESTS + j] = ((j >> i) % 2) == 1;
                mask[i][1 * REQUESTS + j] = ((j >> i) % 2) == 1;
            }
        }

        return mask;
    }

    for i in 0..N_SLOTS :g_state {
        var match_priority: logic;

        always_comb {
            match_priority = (!PRIORITY_ENABLE) || (grant_priority == (i as PRIORITY_WIDTH));
        }

        always_ff {
            if_reset {
                current_state[i] = 0 as STATE_WIDTH;
            } else if i_init {
                current_state[i] = 0 as STATE_WIDTH;
            } else if (i_request != '0) && i_update_state && match_priority {
                current_state[i] = grant_index;
            }
        }
    }

    //--------------------------------------------------------------
    //  Weight
    //--------------------------------------------------------------
    if WEIGHT_ENABLE :g_weight {
        const RESET_COUNT_WIDTH: u32 = clog2_clipped(REQUESTS, 1);
        const MAX_RESET_COUNT  : u32 = REQUESTS - 1;

        var weight_eq_0      : logic<REQUESTS>         ;
        var weight_eq_0_grant: logic<REQUESTS>         ;
        var reset_count      : logic<RESET_COUNT_WIDTH>;
        var reset_weight     : logic                   ;

        always_comb {
            reset_weight = i_init || weight_eq_0_grant != '0 && reset_count == (MAX_RESET_COUNT as RESET_COUNT_WIDTH)
                || weight_eq_0 == '1;
        }

        always_ff {
            if_reset {
                reset_count = 0 as RESET_COUNT_WIDTH;
            } else if reset_weight {
                reset_count = 0 as RESET_COUNT_WIDTH;
            } else if weight_eq_0_grant != '0 {
                reset_count += 1 as RESET_COUNT_WIDTH;
            }
        }

        for i in 0..REQUESTS :g {
            var grant: logic;
            var eq_0 : logic;
            var eq_1 : logic;

            always_comb {
                grant                = i_request[i] && grant_location[i];
                eq_0                 = weight[i] == (0 as WEIGHT_WIDTH);
                eq_1                 = weight[i] == (1 as WEIGHT_WIDTH);
                weight_eq_0[i]       = eq_0 || eq_1 && grant;
                weight_eq_0_grant[i] = grant && eq_0;
            }

            always_ff {
                if_reset {
                    weight[i] = INITIAL_WEIGHT[i];
                } else if reset_weight {
                    if i_weight_valid {
                        weight[i] = i_weight[i];
                    } else {
                        weight[i] = INITIAL_WEIGHT[i];
                    }
                } else if grant && !eq_0 {
                    weight[i] -= (1 as WEIGHT_WIDTH);
                }
            }
        }
    } else {
        always_comb {
            weight = '0;
        }
    }
}
