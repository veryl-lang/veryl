%YAML 1.2
---
name: Veryl
file_extensions: [veryl]
version: 2
scope: source.veryl

variables:
  identifier: '(?:r#)?[a-zA-Z_][0-9a-zA-Z_$]*'
  keyword_start: '(?<![0-9a-zA-Z_$#])'
  keyword_end: '(?![0-9a-zA-Z_$])'

contexts:
  main:
    - include: comments
    - include: string
    - match: '{{keyword_start}}embed{{keyword_end}}'
      scope: keyword.declaration.veryl
      push: embed-header
    - match: '{{keyword_start}}(?:embed|enum|function|include|interface|modport|module|package|proto|pub|struct|union|unsafe){{keyword_end}}'
      scope: keyword.declaration.veryl
    - match: '{{keyword_start}}(?:alias|always_comb|always_ff|assign|as|bind|block|connect|const|final|gen|import|initial|inst|let|mixin|param|return|break|type|var|false|lsb|msb|true){{keyword_end}}'
      scope: keyword.other.veryl
    - match: '{{keyword_start}}(?:case|default|else|if_reset|if|inside|outside|switch|for|in|repeat|rev|step){{keyword_end}}'
      scope: keyword.control.veryl
    - match: '{{keyword_start}}(?:bit|bbool|lbool|clock|clock_posedge|clock_negedge|f32|f64|i8|i16|i32|i64|logic|reset|reset_async_high|reset_async_low|reset_sync_high|reset_sync_low|signed|string|tri|p8|p16|p32|p64|u8|u16|u32|u64){{keyword_end}}'
      scope: storage.type.veryl
    - match: '{{keyword_start}}(?:converse|inout|input|output|same){{keyword_end}}'
      scope: storage.modifier.veryl
    - match: '`[a-zA-Z0-9_]+'
      scope: constant.language.veryl
    - match: '\$[a-zA-Z_][0-9a-zA-Z_$]*'
      scope: variable.other.veryl
    - match: '{{identifier}}'
      scope: variable.other.veryl

  embed-header:
    - include: comments
    - match: '\{\{\{'
      set: embed-body
    - match: '{{identifier}}'
      scope: variable.other.veryl
    - match: '[;}]'
      pop: true

  embed-body:
    # Deliberately no Veryl comments/strings/keywords/operators here.
    - match: '\\.'
    - match: '\}\}\}'
      pop: true
    - match: '\{'
      push: embed-inner

  embed-inner:
    - match: '\\.'
    - match: '\{'
      push: embed-inner
    - match: '\}'
      pop: true

  string:
    - match: '"'
      push:
        - meta_scope: string.quoted.double.veryl
        - match: '\\["\\fnt]'
          scope: constant.character.escape.veryl
        - match: '"|$'
          pop: true

  comments:
    - match: '/\*'
      captures:
        0: punctuation.definition.comment.veryl
      push:
        - meta_scope: comment.block.veryl
        - match: '\*/'
          pop: true
    - match: '(//).*$'
      scope: comment.line.double-slash.veryl
      captures:
        1: punctuation.definition.comment.veryl
