pub module Module60A (
    i_clk_a: input  'a clock,
    i_rst_a: input  'a reset,
    i_dat_a: input  'a logic,
    o_dat_a: output 'a logic,
    i_clk_b: input  'b clock,
    i_rst_b: input  'b reset,
    i_dat_b: input  'b logic,
    o_dat_b: output 'b logic,
) {
    assign o_dat_a = i_dat_a;
    assign o_dat_b = i_dat_b;
}

pub module Module60B (
    i_clk   : input  '_ clock,
    i_clk_x2: input  '_ clock,
    i_dat   : input     logic,
    o_dat   : output    logic,
) {
    assign o_dat = i_dat;
}

pub module Module60C (
    i_clk: input     clock,
    i_dat: input     logic,
    o_dat: output    logic,
    i_thr: input  'a logic,
    o_thr: output 'a logic,
) {
    assign o_dat = i_dat;
    assign o_thr = i_thr;
}

interface Interface60D {
    var dat: logic;
}

pub module Module60D (
    i_clk_hclk: input  'hclk clock,
    i_rst_hclk: input  'hclk reset,
    i_dat_hclk: input  'hclk logic,
    o_dat_hclk: output 'hclk logic,
    i_dat_xclk: input  'xclk logic,
    o_dat_xclk: output 'xclk logic,
    i_dat_data: input  'data logic,
    o_dat_data: output 'data logic,
) {
    var r_dat: 'hclk logic;
    let w_dat: 'xclk logic = i_dat_xclk;

    inst u_if: 'data Interface60D;

    always_ff {
        if_reset {
            r_dat = 0;
        } else {
            r_dat = i_dat_hclk;
        }
    }

    assign o_dat_hclk = r_dat;
    assign o_dat_xclk = w_dat;
    assign u_if.dat   = i_dat_data;
    assign o_dat_data = u_if.dat;
}
