module Module68H #(
    param WIDTH       : u32 = 8                                        ,
    const RESULT_WIDTH: u32 = $std::lzc_common_pkg::result_width(WIDTH),
) (
    i_d     : input  logic<WIDTH>       ,
    o_result: output logic<RESULT_WIDTH>,
) {
    assign o_result = $std::lzc::<WIDTH>(i_d, true);
}
