package Package92 {
    struct FpT::<EXP_W: p32, MTS_W: p32> {
        sign: logic       ,
        exp : logic<EXP_W>,
        mts : logic<MTS_W>,
    }

    impl FpT {
        const BIAS: u32 = (1 << (EXP_W - 1)) - 1;

        function is_nan (
            self,
        ) -> logic {
            return (self.exp == '1) && (self.mts != '0);
        }
    }

    impl FpT::<2, 1> {
        function is_nan (
            self,
        ) -> logic {
            return 1'b0;
        }
    }

    type Fp16 = FpT::<5, 10>;
    type Fp32 = FpT::<8, 23>;
    type Fp4  = FpT::<2, 1> ;
    type Fp6  = FpT::<3, 2> ;

    impl Fp6 {
        function is_nan (
            self,
        ) -> logic {
            return 1'b0;
        }
    }
}

module Module92 (
    i_x  : input  Package92::Fp32,
    o_nan: output logic          ,
    o_b  : output u32            ,
) {
    struct PairT {
        a: logic<8>,
        b: logic<8>,
    }

    impl PairT {
        const WIDTH: u32 = 16;

        function sum (
            self,
        ) -> logic<8> {
            return self.a + self.b;
        }

        function add (
            self,
            x: input logic<8>,
        ) -> logic<8> {
            return self.a + x;
        }

        function log (
            self,
        ) {
            $display("%d", self.a);
        }
    }

    var p: PairT;

    always_comb {
        p.a = 8'd1;
        p.b = 8'd2;
    }

    let _s: logic<8> = p.sum();
    let _t: logic<8> = p.add(8'd1);
    let _u: logic<8> = PairT::sum(p);
    let _v: u32      = PairT::WIDTH;
    let _w: u32      = Package92::FpT::<5, 10>::BIAS;

    assign o_nan = i_x.is_nan();
    assign o_b   = Package92::Fp32::BIAS;

    var m : Package92::Fp4;
    let _n: logic          = m.is_nan();
    let _o: u32            = Package92::Fp4::BIAS;
    always_comb {
        m.sign = 0;
        m.exp  = 0;
        m.mts  = 0;
    }

    var q : Package92::Fp6;
    let _y: logic          = q.is_nan();
    let _z: u32            = Package92::Fp6::BIAS;
    always_comb {
        q.sign = 0;
        q.exp  = 0;
        q.mts  = 0;
    }

    initial {
        p.log();
        PairT::log(p);
    }
}
