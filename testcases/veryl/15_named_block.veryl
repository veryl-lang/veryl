module Module15 {
    let _a: logic = 1;

    :label {
        let _a: logic = 1;
    }

    :label1 {
        // a comment at the top of the block
        let _a: logic = 1;
    }

    for i in 0..10 :label2 {
        // the same in a loop body
        :label {
            let _a: logic = 1;
        }
    }
}
