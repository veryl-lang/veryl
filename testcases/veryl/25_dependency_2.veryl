alias package barpkg = veryl_sample4::bar_pkg::<32>;
alias package foopkg = veryl_sample4::foo_pkg::<barpkg::BAR>;
alias package bazpkg = veryl_sample4::baz_pkg::<Package25::<1>::C, Package25::<2>::C>;

module Module25A (
    i_clk : input   clock                         ,
    i_rst : input   reset                         ,
    in_if : modport veryl_sample3::data_if::mp_in ,
    out_if: modport veryl_sample3::data_if::mp_out,
) {
    import barpkg::*;
    import bazpkg::*;

    inst data_if: veryl_sample3::data_if;

    inst u0: veryl_sample::delay (
        i_clk                ,
        i_rst_n: i_rst       ,
        i_d    : in_if.data  ,
        o_d    : data_if.data,
    );

    inst u1: veryl_sample2::delay (
        i_clk                ,
        i_rst_n: i_rst       ,
        i_d    : data_if.data,
        o_d    : out_if.data ,
    );

    inst u2: veryl_sample4::bar_module::<foopkg, barpkg>;
}

module Module25B::<PKG: ProtoPackage25> (
    if3: modport veryl_sample4::qux_if::<PKG::S>::mp,
    if4: modport veryl_sample4::qux_if::<S>::mp     ,
) {
    import PKG::*;

    inst u5: veryl_sample4::qux_if::<PKG::S>;
    inst u6: veryl_sample4::qux_if::<S>;

    assign u5.qux.s = '0;
    assign u6.qux.s = '0;

    let _a: logic = if3.qux.s;
    let _b: logic = if4.qux.s;

    :g {
        let _c: logic = if3.qux.s;
        let _d: logic = if4.qux.s;
        let _e: logic = u5.qux.s;
        let _f: logic = u6.qux.s;
    }
}

module Module25C::<V: u32> {
    inst u5: veryl_sample4::quu_module::<V>;
}

alias package package_25 = Package25::<1>;

module Module25D {
    inst qux_if: veryl_sample4::qux_if::<Package25::<1>::S>;
    assign qux_if.qux = 0;
    inst u6: Module25B::<Package25::<1>> (
        if3: qux_if,
        if4: qux_if,
    );
    inst u7: Module25C::<package_25::C>;

    let _a: logic = qux_if.qux.s;
}

module Module25E {
    const QUX_0: u32 = veryl_sample4::qux_pkg::QUX_0;
    const QUX_1: u32 = veryl_sample5::qux_pkg::QUX_1;
}

module Module25F #(
    param WIDTH: u32 = 8,
) (
    i_a: input  logic<WIDTH>,
    i_b: input  logic<WIDTH>,
    o_c: output logic<WIDTH>,
) {
    assign o_c = veryl_sample4::foo_func_1::<WIDTH>(i_a, i_b);
}

module Module25G {
    import bazpkg::BAZ_0;
    import bazpkg::BAZ_1;
    let _f0: u32 = BAZ_0;
    let _f1: u32 = BAZ_1;

    // the module import stays visible in nested scopes
    :g {
        let _f2: u32 = BAZ_0;
        :h {
            let _f3: u32 = BAZ_1;
        }
    }

    function f () -> u32 {
        return BAZ_0 + BAZ_1;
    }
    let _f4: u32 = f();
}

package Pacakge25H {
    gen BAZ_0_VALUE: u32 = 1;
    gen BAZ_1_VALUE: u32 = 2;
    alias package baz_1_2 = veryl_sample4::baz_pkg::<BAZ_0_VALUE, BAZ_1_VALUE>;
}

module Module25I {
    import Pacakge25H::baz_1_2;

    alias package baz_1_3 = veryl_sample4::baz_pkg::<baz_1_2::BAZ_0, 3>;

    inst baz: veryl_sample4::baz_if::<baz_1_3>;
    :g {
        inst u: veryl_sample4::baz_module::<baz_1_3> (
            baz: baz,
        );
    }
}

module Module25J {
    import Pacakge25H::baz_1_2;

    alias package baz_1_3 = veryl_sample4::baz_pkg::<baz_1_2::BAZ_0, 3>;

    // driven only under the ifdef below
    #[allow(unassign_variable)]
    inst baz: veryl_sample4::baz_if::<baz_1_3>;
    // a guarded block still sees the module's unguarded import
    #[ifdef(DEFINE_A)]
    :g {
        inst u: veryl_sample4::baz_module::<baz_1_3> (
            baz: baz,
        );
    }
}

module Module25K {
    // the reverse: guarded import, unguarded reference
    #[ifdef(DEFINE_A)]
    import Pacakge25H::baz_1_2;

    alias package baz_1_3 = veryl_sample4::baz_pkg::<baz_1_2::BAZ_0, 3>;

    inst baz: veryl_sample4::baz_if::<baz_1_3>;
    inst u: veryl_sample4::baz_module::<baz_1_3> (
        baz: baz,
    );
}
