pub function foo_func_1::<W: u32> (
    a: input logic<W>,
    b: input logic<W>,
) -> logic<W> {
    return a + b + foo_func_2();
}

pub function foo_func_2 () -> u32 {
    return 2;
}

pub function foo_func_3::<T: type> (
    a: input T,
    b: input T,
) -> T {
    return a + b;
}

pub function foo_func_4::<T: type> (
    a: input T,
    b: input T,
) -> T {
    return foo_func_3::<T>(a, b);
}
