module SignedConstant (
    a: input  logic<64>,
    o: output logic<64>,
) {
    const P    : signed logic<8>  = 64'd255;
    let   value: logic       <64> = P;
    assign o = a & value;
}

#[test(test_signed_constant)]
module test_signed_constant {
    inst clk: $tb::clock_gen;

    var a: logic<64>;
    var o: logic<64>;
    inst dut: SignedConstant ( a, o );

    initial {
        a = 64'hffff_ffff_ffff_ffff;
        clk.next();
        $display("a=%h o=%h", a, o);
        $assert(o == 64'hffff_ffff_ffff_ffff);
        $finish();
    }
}

#[test(test_constant_type_contexts)]
module test_constant_type_contexts {
    inst clk: $tb::clock_gen;

    // Truncate the initializer before extending each reference to its context.
    const UNSIGNED: logic       <8> = 64'd511;
    const NEGATIVE: signed logic<8> = 64'd384;
    const POSITIVE: signed logic<8> = 64'd383;
    const ONE     : bit             = 64'd3;

    let unsigned_value: logic<64>  = UNSIGNED;
    let negative_value: logic<128> = NEGATIVE;
    let positive_value: logic<64>  = POSITIVE;
    let mixed_value   : logic<64>  = NEGATIVE + 64'd0;
    let mask          : logic<64>  = {ONE repeat 64};

    initial {
        clk.next();
        $assert(unsigned_value == 64'hff);
        $assert(negative_value == 128'hffff_ffff_ffff_ffff_ffff_ffff_ffff_ff80);
        $assert(positive_value == 64'h7f);
        $assert(mixed_value == 64'h80);
        $assert(mask == 64'hffff_ffff_ffff_ffff);
        $finish();
    }
}
